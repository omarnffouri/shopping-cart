.ql-snow .ql-editor img
  width auto


.custom-toolbar
  display flex
  gap 15px
  align-items center

.ql-editor
  min-height 200px
  max-height 400px

  li
    line-height 1.9
    display block

.focused
  .ql-container
    border-color #444 !important

  .ql-toolbar.ql-snow
    border-color #444 !important
    border-bottom 1px solid #ccc

.ql-toolbar.ql-snow + .ql-container.ql-snow
  border-radius 0 0 5px 5px

.ql-toolbar.ql-snow
  border-radius 5px 5px 0 0

.has-error
  .whysigwyg-error
    .ql-container
      border-color red !important

    .ql-toolbar.ql-snow
      border-color red !important


.ql-editing
  left 0!important

.full-screen
  padding 30px
  position fixed
  top 0
  bottom 0
  left 0
  right 0
  z-index 10
  display flex
  flex-direction column
  background #fff

  .ql-editor
    max-height 4000px

  .quillWrapper
    display flex
    flex-direction column
    flex-grow 1

    .ql-container
      flex-grow 1

  textarea
    flex-grow 1

@media only screen and (max-width: 768px)
  .wysiwyg-wrapper
    .dply-felx
      display block
      margin 10px 0

      .custom-toolbar
        button
          margin-top 10px
