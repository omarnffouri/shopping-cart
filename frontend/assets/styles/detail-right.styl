@import "variables.styl";

.rtl .product-detail
  padding-right 0
  padding-left detail-right-width

.rtl .product-detail > .detail-right
  right auto
  left 0

.rtl .product-detail > .detail-left
  margin-left 20px!important
  margin-right 0!important

.p-tile .discount
  word-break break-all

.price-wrapper
  gap 5px
  display flex
  align-items center
  word-break break-all
  flex-wrap wrap
  white-space break-spaces

.mobile-detail-tabs
  display none

.detail-right
  .delivery-today-banner.mobile-only-assurance
  .secure-trans-toggle.mobile-only-assurance
    display none !important

  .detail-action-buttons
    display flex
    gap 10px

    .action-btn
      width 50%

  .detail-price-toggle
    display inline-flex
    flex-direction row
    align-items center
    gap 0


    .details-scroll
      background transparent
      border 0
      padding 0
      cursor pointer
      color inherit
      font-size 1.25rem
      font-weight 700
      line-height 1.1

    .details-popover
      background transparent
      border 0
      padding 0
      cursor pointer
      display inline-flex
      align-items center
      justify-content center
      margin-top 10px

  .wishlist-action
    display inline-flex
    align-items center
    padding 8px 24px
    border 0
    background transparent
    color #2a2a2a
    font-weight 600
    cursor pointer
    transition color .2s ease
    direction ltr

    .icon
      height 20px
      width 20px
      min-width 20px
      opacity .9
      transition transform .2s ease, filter .2s ease

    .wishlist-text
      position relative
      direction rtl
      font-size: 1.2em

      &:after
        content ''
        position absolute
        left 0
        right 0
        bottom -3px
        height 2px
        background var(--primary-color)
        transform scaleX(0)
        transform-origin left
        transition transform .2s ease

    .wishlist-dot
      width 6px
      height 6px
      border-radius 50%
      background var(--primary-color)
      opacity 0
      transform translateY(2px)
      transition opacity .2s ease, transform .2s ease

    &:hover
      color var(--primary-color)

      .wishlist-text:after
        transform scaleX(1)

      .wishlist-dot
        opacity .7
        transform translateY(0)

    &.active
      color var(--primary-color)

      .icon
        filter brightness(.9) saturate(1.2)
        animation wishlist-pop .25s ease

      .wishlist-text:after
        transform scaleX(1)

    &.loading
      pointer-events none
      opacity .7

      .wishlist-dot
        opacity 1
        animation wishlist-pulse 1s ease infinite

  .note-inputs
    display grid
    grid-template-columns 1fr 1fr
    gap 12px
    margin 32px 0 5px

    @media only screen and (max-width: 768px)
      grid-template-columns 1fr

  .delivery-today-banner
    margin 24px 0 12px
    padding 10px 12px
    border-radius 10px
    background #f2f4f8
    display inline-flex
    align-items flex-start
    gap 10px
    width fit-content
    max-width 100%

    .delivery-today-icon
      flex 0 0 auto
      color #4d5562
      margin-top 1px

    .delivery-today-content
      min-width 0

    .delivery-today-title
      margin 0
      font-size 1.08em
      line-height 1.2
      color #4d5562
      font-weight 600

    .delivery-today-highlight
      color var(--primary-color)

    .delivery-today-note
      margin 4px 0 0
      font-size .90em
      line-height 1.25
      color #5d6470

  .note-field
    display flex
    flex-direction column
    gap 6px

  .note-label
    font-weight 600
    font-size 0.95rem

  .note-upload
    border 1px solid #e2e2e2
    border-radius 8px
    padding 12px
    min-height 88px
    height 88px
    width 100%
    box-sizing border-box
    display flex
    align-items center
    justify-content flex-start
    position relative
    background #f8fafc
    overflow hidden
    transition box-shadow .2s ease, border-color .2s ease

    &:after
      content ''
      position absolute
      inset 8px
      border-radius 6px
      border 1px dashed #000
      opacity .35
      pointer-events none

    input[type="file"]
      position absolute
      inset 0
      opacity 0
      cursor pointer
      z-index 3

    &:hover
      border-color #d5d5d5
      box-shadow 0 4px 10px rgba(0, 0, 0, .05)

    &.invalid
      border-color #e85a5a
      box-shadow 0 0 0 1px rgba(232, 90, 90, .12)

  .note-preview
    display flex
    align-items center
    gap 10px

    img
      height 48px
      width 48px
      object-fit cover
      border-radius 6px
      border 1px solid #ddd

    .note-change
      background transparent
      border 0
      color var(--primary-color)
      font-weight 600
      cursor pointer

  .note-placeholder
    text-align left
    display flex
    align-items center
    gap 10px
    width 100%
    padding 0 14px
    box-sizing border-box
    z-index 2
    pointer-events none

  .note-placeholder-row
    display flex
    align-items center
    justify-content flex-start

  .note-placeholder-copy
    display flex
    flex-direction column
    gap 1px
    min-width 0

  .note-placeholder-icon
    width 28px
    height 28px
    border-radius 8px
    background #f2f2f2
    position relative
    flex 0 0 28px

    &:before
      content ''
      position absolute
      top 5px
      left 6px
      width 6px
      height 6px
      border-radius 50%
      background #d4af37

    &:after
      content ''
      position absolute
      left 4px
      bottom 5px
      width 18px
      height 11px
      background #d4af37
      clip-path polygon(0 100%, 45% 28%, 64% 55%, 100% 8%, 100% 100%)

  .note-placeholder-title
    font-size .74rem
    color #111
    font-weight 600
    line-height 1.2

  .note-placeholder-sub
    font-size .62rem
    color #111
    opacity .6
    line-height 1.2

  .note-textarea
    min-height 88px
    border 1px solid #e2e2e2
    border-radius 8px
    padding 10px
    margin-left 2px
    resize vertical
    white-space pre-wrap
    overflow-wrap anywhere
    word-break break-word

  .note-meta
    display flex
    justify-content space-between
    align-items center

  .note-count
    font-size 0.8rem
    color #999

.product-info-panel
  .wishlist-action
    display inline-flex
    align-items center
    border 0
    background transparent
    color #2a2a2a
    font-weight 600
    cursor pointer
    transition color .2s ease
    direction ltr

    .icon
      height 20px
      width 20px
      min-width 20px
