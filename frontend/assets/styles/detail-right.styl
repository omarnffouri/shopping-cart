  .stock-indicator
    padding-left 6px
    margin 0

  .stock-secure-inline
    display inline-flex
    align-items center
    margin-top 4px
    max-width 100%

  .stock-secure-divider
    color #8a8a8a
    font-weight 500

  .mobile-secure-trans
    display none

@keyframes wishlist-pop
  0%
    transform scale(1)
  50%
    transform scale(1.2)
  100%
    transform scale(1)

@keyframes wishlist-pulse
  0%
    transform scale(1)
    opacity .4
  50%
    transform scale(1.4)
    opacity 1
  100%
    transform scale(1)
    opacity .4


.product-detail
  position relative
  padding-right detail-right-width

  > .detail-right
    position absolute
    top 0
    right 0
    bottom 0
    width detail-right-width

    .sticky-right
      top 125px
      position sticky
      z-index 0

      .price-wrapper
        .strike-through
          font-size .7em

      .content
        padding 0

.detail-page
  .product-detail
    padding-right 0

@media only screen and (min-width: 769px)
  .detail-page
    .container-fluid.mtb-15
      max-width 1100px
      margin-left auto
      margin-right auto

  .detail-page
    .product-detail > .detail-left
      max-width 1360px
      width 100%
      margin-left auto !important
      margin-right auto !important

  .detail-right-inline
    margin-top 10px
    position relative
    z-index 1

    .sticky-right
      position static

    .content
      text-align start

      > .start
        justify-content start

    .price-wrapper
      justify-content center

    .detail-price-toggle
    .secure-trans-toggle
      display inline-flex
      justify-content center

    .detail-action-buttons
      justify-content start

      .action-btn
        width 300px
        flex 0 0 300px

    .outline-btn.hide-sm
      width 300px
      margin-left 0
      margin-right auto


@media only screen and (max-width: 1200px)
  .rtl .product-detail
    padding-right 0
    padding-left 250px


  .product-detail
    padding-right 250px

    > .detail-right
      width 250px

    .dropdown-inner
      left auto
      right 0

@media only screen and (max-width: 992px)
  .no-scroll
    .product-detail
      > .detail-right
        z-index 2

@media only screen and (max-width: 768px)
  .detail-page
    padding-bottom 90px
    .product-detail
      display block
      max-width 100%
      gap 0

  .rtl .product-detail > .detail-left
    margin-left 0!important

  .rtl .product-detail
    padding-left 0


  .product-detail
    padding-right 0
     /*padding-bottom 90px*/

    > .detail-right
    .detail-right-inline
      width 100%
      position static

      .sticky-right
        position static

      .content
        background none
        padding 15px 0 0
        margin-top 10px
        border 0
        border-top 1px solid #ddd
        border-radius 0
        /*padding-bottom 90px*/

      .delivery-today-banner.mobile-only-assurance
        display inline-flex !important

      .secure-trans-toggle.mobile-only-assurance
        display flex !important
        justify-content flex-start !important
        text-align left
        background #f2f4f8
        border-radius 10px
        padding 10px 12px
        width fit-content
        max-width 100%
      
      .start
        flex-wrap nowrap
        align-items center

        .wishlist-action
          margin-left auto

          .wishlist-text
            font-size 1em

      .detail-price-toggle
      .secure-trans-toggle
        display none

      .mobile-secure-trans.secure-trans-toggle
        display inline-flex

      .mobile-detail-tabs
        display block
        margin 10px 0 15px
        padding 10px
        border 1px solid #ddd
        border-radius 10px
        background #fff

        .tab-list
          display flex
          gap 8px
          margin-bottom 10px
          justify-content center
          width 100%

        .tab
          flex 1
          min-width 0

          border 1px solid #ddd
          border-radius 8px
          background #fff
          font-size .9em
          font-weight 600
          color #222
          text-align center

          &.active
            border-color #c8a330

        .tab-content
          font-size .9em
          color #333

        .detail-list
          margin 0
          padding-left 16px

          li
            margin 4px 0

      .detail-action-bar
        position fixed
        bottom 0
        left 0
        right 0
        z-index 5
        background transparent
        padding 0
        box-shadow none

      .detail-action-buttons
        gap 0

        .action-btn
          margin 0 !important
          border-radius 0
          height 54px
          line-height 54px

        .action-btn:first-child
          border-top-left-radius 0
          border-bottom-left-radius 0

        .action-btn:last-child
          border-top-right-radius 0
          border-bottom-right-radius 0

        .action-btn + .action-btn
          border-left 0

        .outline-btn
          background #eee
          border-color #eee
