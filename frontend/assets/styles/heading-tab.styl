@import "variables.styl"

.heading-tab-wrapper
  .tab-heading
    gap 15px
    flex-wrap wrap
    display flex

    label
      height 120px
      width 120px
      display flex

      align-items center
      cursor pointer
      padding 15px
      justify-content center
      text-align center
      flex-direction column

      background #f4f5f5
      border 1px solid #eee
      border-radius border-radius
      position relative

      &:before
        content ''
        position absolute
        opacity 0
        top: -10px
        right: -10px
        height 22px
        min-width 22px
        border-radius 22px
        display inline-block
        border 4px solid #aaa

      &:hover
        background selection-bg-color
        border 1px solid primary-color

      &:active
        background selection-bg-color
        border-color primary-color

      &.active
        background selection-bg-color
        border 1px solid primary-color
        cursor auto

        &:before
          opacity 1
          border none
          background primary-color
          background-image url(svg-sprite)
          background-position 33.5% 22.5%
          background-size 1000% 1000%

        &:hover
        &:active
          border 1px solid primary-color
          background selection-bg-color

      input
        max-width 0
        max-height 0
        opacity 0


      i
        min-height 40px
        min-width 40px

        & + span
          padding 5px 0 10px

  .tab-content
    padding-top 15px

