@import "variables.styl"

.discover-area
  width 100%

.p-tile > .page-link
  display block

.discount
  background home-bg
  color offer-color
  padding 1px 4px
  font-size .75em
  font-weight 600
  border-radius 4px

.p-tile
  margin-bottom 15px
  position relative
  z-index 0
  transition all .1s
  cursor pointer
  border-radius border-radius
  border 1px solid rgba(0, 0, 0, 0)

  &:hover
    .img-wrapper
      & > .compare-btn
        opacity 1
        transform translateX(0)


  .img-wrapper
    margin 5px 0
    position relative


    .badge
    & > .compare-btn
      position absolute
      top 0
      z-index 1


    & > .compare-btn
      right 5px
      opacity 0
      transform translateX(20px)
      transition all .2s

      i
        &.close-icon
          transform scale(.7)

    .badge
      left 5px
      font-size .7em
      padding 2px 5px
      color #fff
      border-radius 3px
      background primary-color

    .fav-btn
      position absolute
      top 10px
      right 10px
      height auto
      font-size 2em
      z-index 10
      line-height 1
      color #666

      span
        line-height 1

  .item-title
    h5
      font-weight 500

    .flex.wrap.start
      margin-bottom 14px
      &.has-delivery
        margin-bottom 4px

    .tile-delivery
      margin-top 6px
      font-size .85em
      color #666

      .delivery-date
        color primary-color
        font-weight 600
        margin-left 4px

    .tile-reviews
      display flex
      align-items center
      gap 8px
      margin-top 8px
      margin-bottom 12px

      .review-badge
        background #1e8f3a
        color #fff
        font-weight 700
        font-size .85em
        padding 3px 6px
        border-radius 4px

      .review-count
        color #666
        font-size .9em

.p-tile
  & > .page-link
    display block

.user-compared
.user-wishlists
  .tile-container
    .p-tile
      min-width 25%
      width 25%

.tile-container
  display flex
  flex-wrap wrap
  margin 0 -10px

  .p-tile
    width 16.66%
    min-width 16.66%
    padding 0 10px
    margin-bottom 15px


@media only screen and (max-width: 1400px)
  .tile-container
    .p-tile
      min-width 20%
      width 20%

@media only screen and (max-width: 1200px)
  .tile-container
    .p-tile
      width 25%
      min-width 25%

@media only screen and (max-width: 992px)
  .user-compared .tile-container
  .user-wishlists .tile-container
  .tile-container
    .p-tile
      width 33.33%
      min-width 33.33%

@media only screen and (max-width: 768px)
  .p-tile .img-wrapper > .compare-btn
    transform none
    opacity 1

  .p-tile
    .item-title
      h5
        margin-left 10px

      .flex.wrap.start
        margin-left 10px

      .tile-delivery
        margin-left 10px
        margin-bottom: 6px

  .tile-container
    margin 0
    gap 0

    .p-tile
      padding 0
      border 0
      flex 0 0 50%
      max-width 50%
      margin 0
      border-radius 0

      & > .page-link
        padding 0
        margin 0

      .img-wrapper
        padding 0
        aspect-ratio 1 / 1
        overflow hidden
        background #f0f0f0

  .p-tile
    margin-bottom 0
    .img-wrapper
      margin 0
      img
        padding 0
        width 100%
        height 100%
        display block
        object-fit cover
        border-radius 0

  .user-compared  .tile-container
  .user-wishlists  .tile-container
  .tile-container
    .p-tile
      width 50%
      min-width 50%


@media only screen and (max-width: 576px)
  .tile-container
    margin 0

    .p-tile
      padding 0
      width 50%
      min-width 50%
      margin-bottom 0
