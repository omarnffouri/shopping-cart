@import "variables.styl"

.no-scroll .header-sticky.sticky
.show-cart.detail-page .header-sticky.sticky
  position static

.header-sticky
  background inherit

.header-sticky.sticky
  position fixed
  top 0
  left 0
  right 0

header .compare-btn{
  height: auto!important
  background: transparent;
}

header.no-banner
  padding-top 0
  &:after
    display none

.lang-dropdown.custom-dropdown > span
  background none
  border none
  padding 5px 0
  height auto
  line-height 1

.no-scroll header
  z-index 2

header
  padding-top 4%
  display flex
  flex-direction column
  background header-bg
  position absolute
  top 0
  left 0
  right 0
  z-index 9

  &:after
    background #eee
    content ''

  &:after
  .top-banner
    position absolute
    top 0
    left 0
    right 0
    padding-bottom 4%

  .top-banner
    z-index 1

    img
      height 100%
      width 100%
      position absolute
      top 0
      bottom 0
      left 0
      right 0


  .top-wrapper
    position relative
    z-index 2
    color header-color
    font-size .9em
    border-bottom 1px solid header-border

    .left-side
    .right-side

      .arrow-up
      .arrow-down
        margin 0 5px
        height 14px
        width 14px
        min-width 14px

      a
        padding 7.5px 0

  .container-fluid.flex
    margin-top 10px
    margin-bottom 10px

  .logo
    img
      object-fit contain
      max-height 35px

  .arrow-down
    height 18px
    width 18px

  .dropdown
    z-index 11
    min-width 150px
    padding 10px 0
    display none
    position absolute
    top 100%
    left auto
    right 0
    background white
    color font-color
    border-radius border-radius
    box-shadow 1px 2px 10px rgba(0, 0, 0, .1)

    button.clear-btn
    a
      height auto !important
      border-radius 0
      text-align left
      width 100%
      font-size 1em
      font-weight 400
      line-height 1
      display block
      box-shadow none
      padding 15px 20px

      &:hover
        background selection-bg-color

      &:active
        background selection-bg-color

  .active
    display block

  button
  input
    height btn-height !important

  .left-area
  .right-area
    width 250px

  .right-area
    .account-menu-anchor
      .retry-order-timer
        position absolute
        bottom calc(100%)
        right:  30%
        transform none
        z-index 12
        display inline-flex
        align-items center
        justify-content center
        gap 6px
        padding 6px 10px
        border 1px solid #dcdcdc
        border-radius 10px
        background #fff
        color #222
        font-size .78em
        line-height 1
        white-space nowrap
        box-shadow 0 6px 18px rgba(0, 0, 0, .12)

        &:before
          content ''
          position absolute
          bottom -5px
          right  10px
          width 8px
          height 8px
          background #fff
          border-right: 1px solid #dcdcdc
          border-bottom 1px solid #dcdcdc
          transform translateX(-50%) rotate(45deg)

        .retry-order-copy
          color #333
          font-weight 500

        .retry-order-time
          font-weight 700

    button
    .cart-btn
      color header-color
      font-weight 600
      font-size 1.05em
      margin-right: 0
      gap: 10px

    .account-btn
      margin-right 0
      gap 0

      .account-icon-wrap
        position relative
        display inline-flex

      .account-retry-dot
        position absolute
        top 2px
        right 4px
        width 12px
        height 12px
        border-radius 50%
        background primary-color
        border 1px solid #fff

      .account-icon
        display inline-flex
        height 28px
        width 28px
        min-width 28px
        opacity 1
        filter brightness(0)

      .account-text
        display none

      .account-arrow
        display none

    .cart-btn
      .title
        display inline

    .header-search-btn
      display none
      background none
      border none
      height auto
      width auto
      padding 4px 0 0px;
      box-shadow none

      .icon
        height 20px
        width 20px
        min-width 20px
        opacity 1
        filter brightness(0)

    .mobile-menu
      display none

    .mobile-menu-btn
      display none

    .mobile-lang-dropdown
      display none

    .cart-badge
      position absolute
      top 0
      left 12px
      background primary-color
      border 1px solid header-bg
      border-radius 100%
      text-align center
      height 22px
      width 22px
      line-height 20px
      font-size 12px
      z-index 1
      color #fff

  .rtl &
    .right-area
      .cart-badge
        left auto
        right 12px

  .bottom-area
    border-top 1px solid header-border
    border-bottom 1px solid #DDD
    font-size 1.05em
    color header-color

    & > div

      & > .flex
        margin 0 -10px

      a
        font-size .95em
        span
          text-transform uppercase
          font-size .9rem
          padding 12.5px 10px

        &:hover
          background selection-bg-color

        &:active
          background selection-bg-color

.account-retry-dot
  position absolute
  width 12px
  height 12px
  border-radius 50%
  background primary-color
  border 1px solid #fff

@media only screen and (max-width: 992px)
  header
    .top-banner.banner-wrapper
      button
        top 50%
        transform translateY(-50%)
        right 2.5px

    .left-area
    .right-area
      width auto

    form
      margin 0 20px

@media only screen and (max-width: 768px)
  .detail-page
    header
      .bottom-area
        display none

  .rtl header .container-fluid.flex .right-area
    left 15px
    right auto

  .rtl header .container-fluid.flex .right-area
    .cart-badge
      left auto
      right 12px


  header .left-area
    min-height 30px

  header
    .top-wrapper
      padding 5px 0
      font-size .85em

      .container-fluid > .flex
        flex-direction column

      .left-side
      .right-side
        justify-content left

        a
          padding 5px 0

          span > span
            display none

      .lang-dropdown
        display none

      .right-side
        display none

    button
    input
      height 40px !important

    .container-fluid.flex
      display block
      margin-bottom 0

      .logo
        img
          width auto
          height 25px

      .right-area
        position absolute
        top -10px
        right 15px
        gap 4px
        align-items center
        line-height 1

        .account-menu-anchor
          .retry-order-timer
            font-size .68em
            padding 3px 6px
            gap 4px

            .retry-order-copy
              display none

        .account-btn
          .account-icon-wrap
            position relative
            display inline-flex

          .account-retry-dot
            width 7px
            height 7px
            top 2px
            right 2px

          .account-text
            display none

          .account-icon
            display inline-flex
            height 20px
            width 20px
            min-width 20px
            opacity 1
            filter brightness(0)

          .account-arrow
            display none

        .cart-btn
          .title
            display none

          .cart-icon
            height 20px
            width 20px
            min-width 20px
            opacity 1
            filter brightness(0)

        .header-search-btn
          .icon
            height 20px
            width 20px
            min-width 20px
            opacity 1
            filter brightness(0)

        .header-search-btn
          display flex
          visibility visible
          opacity 1

        .account-btn
          display none

        .mobile-menu
          display inline-flex
          align-items center
          line-height 1
          position relative

          .retry-order-timer
            position absolute
            top calc(100% + 8px)
            right 0
            z-index 12
            display inline-flex
            align-items center
            justify-content center
            gap 4px
            padding 3px 6px
            border 1px solid #dcdcdc
            border-radius 8px
            background #fff
            color #222
            font-size .68em
            line-height 1
            white-space nowrap
            box-shadow 0 6px 18px rgba(0, 0, 0, .12)

            &:before
              content ''
              position absolute
              top -5px
              right 8px
              width 8px
              height 8px
              background #fff
              border-left 1px solid #dcdcdc
              border-top 1px solid #dcdcdc
              transform rotate(45deg)

        .mobile-menu-btn
          display inline-flex
          align-items center
          justify-content center
          height 20px
          width 20px
          padding 0
          padding-left: 12px
          background none
          border none

          .menu-dots
            position relative
            display inline-block
            width 3px
            height 3px
            border-radius 50%
            background #000
            box-shadow 0 6px 0 #000, 0 -6px 0 #000

        .mobile-menu-dropdown
          position absolute
          top 26px
          right 0
          min-width 140px
          padding 8px 0
          background #fff
          border-radius 8px
          box-shadow 0 2px 10px rgba(0, 0, 0, .15)
          display none
          z-index 20

          &.active
            display block

          a
            display block
            padding 8px 12px
            color #222
            font-weight 600

          .mobile-menu-account-btn
            width 100%
            text-align left
            padding 8px 12px
            font-weight 600
            background none
            border none

          .mobile-menu-account-list
            padding 0 0 6px

            a
              padding 6px 18px
              font-weight 500

            button.clear-btn
              padding 6px 18px
              width 100%
              text-align left

        .mobile-menu-lang-dropdown
          margin 4px 12px 6px

        .mobile-lang-dropdown
          display inline-flex
          align-items center
          line-height 1

        button
          .cart-icon
            height 25px
            width 25px

    form
      margin 0

    &.mobile-search-open
      .container-fluid.flex
        margin-bottom 10px
      form
        margin 5px 0 0


@media only screen and (max-width: 576px)
  .header-sticky.sticky .container-fluid.flex .right-area
  .header-sticky.sticky .left-area
    display none

  header
    padding-top 6%

    &:after
    .top-banner
      padding-bottom 6%


@media only screen and (max-width: 420px)
  header
    .top-wrapper
      .sided

        .left-side
          gap 0

        .left-side a
        .right-side a
          padding-top 0
          padding-bottom 0

        .left-side
          justify-content space-between

          & > a:first-child
          & > span
            display none


@media only screen and (max-width: 380px)
  header
    .top-wrapper
      .container-fluid > .flex
        flex-direction row

      .sided
        .left-side a
          display none


@media only screen and (max-width: 320px)
  header
    .right-area
      .cart-btn
        .title
          display none
